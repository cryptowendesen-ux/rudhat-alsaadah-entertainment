# ---- Required ----
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-long-strong-password

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/rudhat

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Booking email notification ----
# Email address that will receive booking notifications
NOTIFY_EMAIL=yourname@gmail.com

# ---- Resend (recommended for Render FREE) ----
# Get your API key from resend.com
# If you do not have a verified domain, use the same email
# address for your Resend account and NOTIFY_EMAIL.
RESEND_API_KEY=

# Optional sender address
# MAIL_FROM="Rudhat Bookings <onboarding@resend.dev>"

# ---- Gmail SMTP alternative ----
# Only use this if you have a Render plan that allows SMTP.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Optional ----
SITE_URL=https://rudhat-alsaadah-entertainment.onrender.com
PORT=3000
