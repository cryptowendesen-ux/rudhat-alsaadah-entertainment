# ---- Required ----
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-long-strong-password

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/rudhat

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Booking email notification ----
# Email address that will receive booking notifications
NOTIFY_EMAIL=yourname@gmail.com

# ---- Resend (recommended for Render FREE) ----
# Get your API key from resend.com
# If you do not have a verified domain, use the same email
# address for your Resend account and NOTIFY_EMAIL.
RESEND_API_KEY=

# Optional sender address
# MAIL_FROM="Rudhat Bookings <onboarding@resend.dev>"

# ---- Gmail SMTP alternative ----
# Only use this if you have a Render plan that allows SMTP.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Optional ----
SITE_URL=https://rudhat-alsaadah-entertainment.onrender.com
PORT=3000

# ---- Booking protection (all optional) ----
# Cloudflare Turnstile (free captcha) - create a widget at dash.cloudflare.com > Turnstile.
# Both values are needed; leave empty to keep the check switched off.
# Strongly recommended: free Cloudflare Turnstile keys stop bots from spamming bookings
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# A pending request holds its time slot this many hours, then the slot is free again (default 24)
# PENDING_HOLD_HOURS=24
# Online bookings must start at least this many hours from now (default 3)
# BOOKING_MIN_LEAD_HOURS=3
# How far ahead customers can book, in days (default 365)
# BOOKING_MAX_DAYS_AHEAD=365
# Open upcoming requests allowed per phone number (default 3)
# MAX_ACTIVE_PER_PHONE=3
# Emergency only: skip the owner's 2-step code (phone lost). Sign in, set 2-step up again, then delete this line.
# DISABLE_OWNER_2FA=true
# true = block bookings when Cloudflare cannot be reached (default: allow them)
# TURNSTILE_FAIL_CLOSED=false
# Birthday form: child name + parent/guardian declaration are required (set false to make them optional)
# WAIVER_REQUIRED=true
# Shown to Google in the business data (default "AED 20+")
# PRICE_RANGE=AED 20+

# Days after the party date when a child's name, age and allergy note are erased from the booking (default 90, 7-3650)
# SENSITIVE_RETENTION_DAYS=90

# How long "Keep me signed in" lasts on the admin login (days, default 14, max 90). A normal sign-in lasts 8 hours.
# ADMIN_REMEMBER_DAYS=14
